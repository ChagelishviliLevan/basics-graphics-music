expected_source_script=00_setup.source_bash

if [ -z "$BASH_SOURCE" ]
then
    printf "script \"%s\" should be sourced from \"%s\"\n"  \
        "$0" "$expected_source_script" 1>&2

    exit 1
fi

this_script=$(basename "${BASH_SOURCE[0]}")
source_script=$(basename "${BASH_SOURCE[1]}")

if [ -z "$source_script" ]
then
    printf "script \"%s\" should be sourced from  \"%s\"\n"  \
        "$this_script" "$expected_source_script" 1>&2

    return 1
fi

if [ "$source_script" != $expected_source_script ]
then
    printf "script \"%s\" should be sourced from  \"%s\", not \"%s\"\n"  \
        "$this_script" "$expected_source_script" "$source_script" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------

icarus_verilog_setup ()
{
    if is_command_available iverilog ; then
        return  # Already set up
    fi

    if    [ "$OSTYPE" = "cygwin"    ]  \
       || [ "$OSTYPE" = "msys"      ]
    then
        alt_icarus_install_path="/c/iverilog"

        if [ -d "$alt_icarus_install_path" ]
        then
            export PATH="${PATH:+$PATH:}$alt_icarus_install_path/bin:$alt_icarus_install_path/gtkwave/bin"
        fi
    else
        alt_icarus_install_path="$HOME/install/iverilog"

        if [ -d "$alt_icarus_install_path" ]
        then
            export PATH="${PATH:+$PATH:}$alt_icarus_install_path/bin"
            export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$alt_icarus_install_path/lib"
        fi
    fi
}

#-----------------------------------------------------------------------------

icarus_verilog_choose_generation_flag ()
{
    local full_version_output

    # Not piped through "head -n 1": under "set -o pipefail", iverilog
    # would receive SIGPIPE when head exits early, which "set -e" would
    # then treat as a failure of this assignment.

    full_version_output=$(iverilog -V 2>&1)
    icarus_version_string=${full_version_output%%$'\n'*}

    icarus_version_major=$(printf '%s' "$icarus_version_string"  \
        | sed -n 's/.*[Vv]ersion[[:space:]][[:space:]]*\([0-9][0-9]*\).*/\1/p')

    if [ -z "$icarus_version_major" ]; then
        warning "could not determine the Icarus Verilog version from:"  \
                "\"$icarus_version_string\". Assuming a recent version and using -g2012."

        icarus_generation_flag=-g2012

    elif [ "$icarus_version_major" -lt 11 ]; then
        warning "*** Icarus Verilog version $icarus_version_major is very old."  \
                "Its SystemVerilog support is incomplete and known to be buggy,"  \
                "so simulation may fail to compile or may produce wrong results."  \
                "Please upgrade to Icarus Verilog 12 or newer (13 or 14 preferred)."  \
                "See https://github.com/steveicarus/iverilog for instructions. ***"

        icarus_generation_flag=-g2012

    elif [ "$icarus_version_major" -eq 11 ]; then
        warning "Icarus Verilog version 11 detected. Please consider upgrading to"  \
                "version 12, and preferably 13 or 14, for better SystemVerilog"  \
                "support and bug fixes."

        icarus_generation_flag=-g2012

    elif [ "$icarus_version_major" -eq 13 ]; then
        # -g2023 is not available in the stable 13.0 release (only in
        # development builds past it), so stick with -g2012.

        icarus_generation_flag=-g2012

    elif [ "$icarus_version_major" -ge 14 ]; then
        icarus_generation_flag=-g2023

    else
        # Version 12

        icarus_generation_flag=-g2012
    fi
}

#-----------------------------------------------------------------------------

run_icarus_verilog ()
{
    is_command_available_or_error_and_install iverilog

    icarus_verilog_choose_generation_flag

    rars_assembly

    #-------------------------------------------------------------------------

    shopt -s nullglob

    iverilog $icarus_generation_flag -s tb \
         -I .. -I ../cpu -I "$lab_dir/common" -I "$package_dir/peripherals" \
            ../*.sv "$lab_dir/common"/*.sv "$package_dir/peripherals"/*.sv \
            ../*.v \
        2>&1 | tee "$log"

    shopt -u nullglob

    #-------------------------------------------------------------------------

    vvp a.out 2>&1 | tee "$log"

    if grep -m 1 ERROR "$log" ; then
        warning errors detected
    fi

    #-------------------------------------------------------------------------

    dump_vcd=dump.vcd

    if ! [ -f $dump_vcd ]; then
        warning no $dump_vcd file
        return 0
    fi

    is_command_available_or_error_and_install gtkwave

    gtkwave_script=../gtkwave.tcl

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--script $gtkwave_script"
    fi

    if    [ "$OSTYPE" = "linux-gnu" ]

    then
        gtkwave=gtkwave

    elif  [ "$OSTYPE" = "cygwin"    ]  \
       || [ "$OSTYPE" = "msys"      ]
    then
        if is_command_available surfer ; then

        gtkwave=surfer

    gtkwave_script=../surfer.scr

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--command-file $gtkwave_script"
    fi
        else

    is_command_available_or_error_and_install gtkwave

        gtkwave=gtkwave

    gtkwave_script=../gtkwave.tcl

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--script $gtkwave_script"
    fi
        fi

    elif [[ "$OSTYPE" = "darwin"* ]]
    then
        if [ $(uname -m) = arm64 ]
        then
            is_command_available_or_error_and_install surfer

            gtkwave=surfer

    gtkwave_script=../surfer.scr

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--command-file $gtkwave_script"
    fi
        else
            # For some reason the following way of opening the application
            # under Mac does not read the script file:
            #
            # open -a gtkwave $dump_vcd --args --script $PWD/gtkwave.tcl
            #
            # This way works:

            gtkwave=/Applications/gtkwave.app/Contents/MacOS/gtkwave-bin
        fi
    else
        error 1 "don't know how to run GTKWave on your OS $OSTYPE"
    fi

    command="$gtkwave $dump_vcd $gtkwave_options"

    if [  "$OSTYPE" = "linux-gnu"  ] ||
       [[ "$OSTYPE" = "darwin"*   ]]
    then
        $command &
    else
        $command
    fi
}
